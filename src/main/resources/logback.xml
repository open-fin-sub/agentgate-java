<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ==================== 日志路径 ==================== -->
    <!-- 从环境变量 AGENTGATE_LOG_PATH 读取,本地默认 /Users/eric/hw/xql/javawork/logs/agentgate -->
    <property name="LOG_PATH" value="${AGENTGATE_LOG_PATH:-/Users/eric/hw/xql/javawork/logs/agentgate}"/>

    <!-- ==================== 日志格式 ==================== -->
    <property name="LOG_PATTERN"
              value="[%d{yyyy-MM-dd HH:mm:ss.SSS}] [%X{X-B3-TraceId:-},%X{X-B3-parentSpanId:-},%X{X-B3-SpanId:-}] [%t] [%p] %c{500}.%M:%L - %m%n"/>

    <!-- ==================== 控制台输出(开发调试) ==================== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ==================== 文件输出(按大小+日期滚动) ==================== -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/agentgate.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 文件名:agentgate-日期.序号.log,日期区分当天日志,序号区分同日多次滚动 -->
            <fileNamePattern>${LOG_PATH}/agentgate-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <!-- 单文件最大 100MB -->
            <maxFileSize>100MB</maxFileSize>
            <!-- 保存 30 天 -->
            <maxHistory>30</maxHistory>
            <!-- 总大小上限 10GB -->
            <totalSizeCap>10GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- ==================== 错误日志单独输出 ==================== -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/agentgate-error.log</file>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/agentgate-error-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- ==================== 日志级别 ==================== -->
    <!-- 应用代码:debug(开发环境) -->
    <logger name="com.abchina.llmalf" level="DEBUG"/>

    <!-- Spring 框架:info -->
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.springframework.boot" level="INFO"/>

    <!-- MyBatis:debug(SQL 日志) -->
    <logger name="com.baomidou.mybatisplus" level="DEBUG"/>

    <!-- OkHttp:info -->
    <logger name="okhttp3" level="INFO"/>

    <!-- ==================== 根配置 ==================== -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>

</configuration>
