<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.abchina.llmalf.agentgate.dao.EvaluationTaskDAO">

    <select id="selectAll" resultType="com.abchina.llmalf.agentgate.dao.entity.EvaluationTaskEntity">
        SELECT * FROM agentgate_evaluation_tasks
    </select>

    <select id="selectByKey" resultType="com.abchina.llmalf.agentgate.dao.entity.EvaluationTaskEntity">
        SELECT * FROM agentgate_evaluation_tasks WHERE id_key = #{idKey}
    </select>
    <delete id="deleteByKey">
        DELETE FROM agentgate_evaluation_tasks WHERE id_key = #{idKey}
    </delete>

    <select id="selectByIdForUpdate" resultType="com.abchina.llmalf.agentgate.dao.entity.EvaluationTaskEntity">
        SELECT * FROM agentgate_evaluation_tasks WHERE id_key = #{idKey} FOR UPDATE
    </select>
</mapper>