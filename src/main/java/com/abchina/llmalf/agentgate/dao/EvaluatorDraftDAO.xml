<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.abchina.llmalf.agentgate.dao.EvaluatorDraftDAO">

    <select id="selectByEvaluatorKeyTeamKey" resultType="com.abchina.llmalf.agentgate.dao.entity.EvaluatorDraftEntity">
        SELECT * FROM agentgate_evaluator_drafts WHERE evaluator_key = #{evaluatorKey} AND user_team_key = #{userTeamKey}
    </select>
    <select id="selectByTeamKey" resultType="com.abchina.llmalf.agentgate.dao.entity.EvaluatorDraftEntity">
        SELECT * FROM agentgate_evaluator_drafts WHERE user_team_key = #{userTeamKey}
    </select>
    <select id="selectByIdForUpdate" resultType="com.abchina.llmalf.agentgate.dao.entity.EvaluatorDraftEntity">
        SELECT * FROM agentgate_evaluator_drafts WHERE id_key = #{idKey} FOR UPDATE
    </select>

    <select id="selectByKey" resultType="com.abchina.llmalf.agentgate.dao.entity.EvaluatorDraftEntity">
        SELECT * FROM agentgate_evaluator_drafts WHERE id_key = #{idKey}
    </select>
    <delete id="deleteByKey">
        DELETE FROM agentgate_evaluator_drafts WHERE id_key = #{idKey}
    </delete>
</mapper>