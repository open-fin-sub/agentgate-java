<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.abchina.llmalf.agentgate.dao.DatasetVersionDAO">

    <select id="selectByDatasetKeyTeamKey" resultType="com.abchina.llmalf.agentgate.dao.entity.DatasetVersionEntity">
        SELECT * FROM agentgate_dataset_versions WHERE dataset_key = #{datasetKey} AND user_team_key = #{userTeamKey}
    </select>
    <select id="selectByIdForUpdate" resultType="com.abchina.llmalf.agentgate.dao.entity.DatasetVersionEntity">
        SELECT * FROM agentgate_dataset_versions WHERE id_key = #{idKey} FOR UPDATE
    </select>

    <select id="selectByKey" resultType="com.abchina.llmalf.agentgate.dao.entity.DatasetVersionEntity">
        SELECT * FROM agentgate_dataset_versions WHERE id_key = #{idKey}
    </select>
    <delete id="deleteByKey">
        DELETE FROM agentgate_dataset_versions WHERE id_key = #{idKey}
    </delete>
</mapper>