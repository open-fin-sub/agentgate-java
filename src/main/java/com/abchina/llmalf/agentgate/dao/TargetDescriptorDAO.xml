<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.abchina.llmalf.agentgate.dao.TargetDescriptorDAO">

    <select id="selectByTargetRefKey" resultType="com.abchina.llmalf.agentgate.dao.entity.TargetDescriptorEntity">
        SELECT * FROM agentgate_target_descriptors WHERE target_ref_key = #{targetRefKey}
    </select>
    <select id="selectByIdForUpdate" resultType="com.abchina.llmalf.agentgate.dao.entity.TargetDescriptorEntity">
        SELECT * FROM agentgate_target_descriptors WHERE content_sha256 = #{contentSha256} FOR UPDATE
    </select>
</mapper>
