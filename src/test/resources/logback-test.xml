<?xml version="1.0" encoding="UTF-8"?>
<!-- 测试环境仅输出控制台(生产文件日志见 logback-spring.xml;logback-test.xml 在测试 classpath 优先加载) -->
<configuration>
    <conversionRule conversionWord="pylevel"
            converterClass="com.abchina.llmalf.agentgate.common.PythonLevelConverter"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>[%d{yyyy-MM-dd HH:mm:ss}] [%thread] [%pylevel] %logger - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
